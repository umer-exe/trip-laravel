# Atlas AI Service — Environment Variables (Groq Edition)
# Copy this file to .env and fill in the values

# Your Groq API key (required)
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...your-key-here...

# URL of the Laravel tours API endpoint
LARAVEL_API_URL=http://localhost:8000/api/tours
